  "facts": [
    {"id":"flat-tree","keywords":["json","tree","parent","children","id","builder data"],"stability":"invariant","text":"Persisted Bricks content is a flat node array. IDs must be unique and resolvable; parent/child relationships may use children or component slotChildren."},
    {"id":"task-local-element-id","keywords":["element id","brxe","selector","generated id","clone","css"],"stability":"invariant","text":"Bricks element IDs are generated task-local evidence. Read the current persisted Bricks tree before using an element ID in CSS/selectors/query targets/migrations; never trust a prior chat, cloned element ID, frontend export, or another project."},
    {"id":"read-tolerant-node","keywords":["children","settings","parent","import","html css import"],"stability":"2.3.13","text":"Bricks 2.3.13 can read leaf/imported nodes without children and treats missing settings as empty. Read validation should normalize these shapes; generated nodes should still use canonical id/name/parent/children/settings."},
    {"id":"element-id-format","keywords":["id","generated id","hash"],"stability":"2.3.13","text":"New Bricks element IDs are six-character lowercase hexadecimal hashes. Preserve existing IDs; generate new IDs in canonical lowercase hex form."},
    {"id":"clipboard-format","keywords":["clipboard","paste","json","section"],"stability":"2.3.13","text":"Clipboard JSON uses source=bricksCopiedElements with content and version, and may bundle sourceUrl, globalClasses, components and globalElements dependencies."},
    {"id":"postmeta-storage","keywords":["postmeta","database","migration","page content","header","footer"],"stability":"2.3.13","text":"Builder storage uses _bricks_page_content_2, _bricks_page_header_2 or _bricks_page_footer_2 plus _bricks_editor_mode=bricks."},
    {"id":"typography-shape","keywords":["typography","font","font-size","style","json"],"stability":"2.3.13","text":"_typography uses CSS property names such as font-size and font-weight; camelCase keys are not the verified shape."},
    {"id":"shadow-shape","keywords":["shadow","box shadow","style","json"],"stability":"2.3.13","text":"_boxShadow keeps offsets/blur/spread inside values and color beside values."},
    {"id":"gradient-shape","keywords":["gradient","background","style","json"],"stability":"2.3.13","text":"_gradient uses colors entries shaped as {color, stop}; do not invent a stops array."},
    {"id":"responsive-breakpoints","keywords":["responsive","desktop","mobile","tablet","breakpoint","base"],"stability":"2.3.13","text":"Default Bricks 2.3.13 breakpoints are desktop (base), tablet_portrait, mobile_landscape and mobile_portrait. Projects may define custom breakpoints and a different base/mobile-first order."},
    {"id":"component-variant-setting","keywords":["component","variant","variant-","settings"],"stability":"2.3.13","text":"Component variant settings may add a variant-* token to a setting key. Resolve variant, configured breakpoint and pseudo tokens instead of treating every suffix as a breakpoint."},
    {"id":"component-slot-children","keywords":["component","slot","slotchildren","parent","children"],"stability":"2.3.13","text":"Component instances can own children through slotChildren. A child parent relation is valid when the child is referenced by parent.children or by a parent.slotChildren slot."},
    {"id":"native-icon","keywords":["icon","dynamic data","svg","custom icon set"],"stability":"2.3.13","text":"Icon controls support built-in or custom icon sets, SVG media, and Dynamic Data. Do not treat the built-in library list as a closed enum."},
    {"id":"query-loop","keywords":["query","loop","posts","terms","users","dynamic"],"stability":"2.3.13","text":"A local native query loop uses hasLoop and query settings. A Global Query loop can store only query.id locally and resolve the rest from bricks_global_queries."},
    {"id":"query-target","keywords":["pagination","filter","ajax","queryid","load more"],"stability":"2.3.13","text":"Query target semantics are element-aware. Pagination may target queryId=main; component runtime targets can be suffixed with an instance ID and are not raw persisted node IDs."},
    {"id":"archive-main-query","keywords":["archive","query","pagination","seo"],"stability":"2.3.13","text":"Archive templates should prefer the native main-query mode when the loop is intended to inherit WordPress archive pagination/context."},
    {"id":"global-queries","keywords":["global query","query id","reuse","query"],"stability":"2.3.13","text":"Global Queries are stored in bricks_global_queries. Preserve the global query reference instead of flattening or overwriting it as a local query unless the user explicitly requests that migration."},
    {"id":"single-template-type","keywords":["single","template","content"],"stability":"2.3.13","text":"The Bricks template type for a normal Single template is content. Do not invent a separate persisted template type named single."},
    {"id":"global-classes","keywords":["class","global class","shared style","card","button"],"stability":"2.3.13","text":"Repeated visual patterns belong in existing global classes/variables where the project already uses them; element nodes reference global classes by ID."},
    {"id":"theme-style-ownership","keywords":["theme style","style manager","container","design system","global"],"stability":"2.3.13","text":"Prefer existing Theme Styles, Style Manager, global variables/classes and component owners before adding page-local raw values or parallel CSS owners."},
    {"id":"external-media","keywords":["image","media","attachment id","reference","url"],"stability":"invariant","text":"Attachment IDs are site-local. Verify the attachment ID against the current WordPress project in the same task; never reuse an ID from another task/project or infer it from a filename/URL."},
    {"id":"section-root","keywords":["section","nest","structure"],"stability":"2.3.13","text":"section is a root-level layout wrapper; do not nest a section beneath another Builder element."}
  ]
