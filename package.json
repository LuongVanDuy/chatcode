{
  "name": "personal-chatcode",
  "version": "0.9.0",
  "description": "Cầu nối dự án cục bộ cho ChatGPT qua MCP",
  "main": "main.js",
  "private": true,
  "scripts": {
    "prepare:icons": "node scripts/generate-icons.cjs",
    "prestart": "npm run prepare:icons",
    "start": "electron .",
    "predev": "npm run prepare:icons",
    "dev": "electron .",
    "test:syntax": "node scripts/generate-icons.cjs && node --check main.js && node --check preload.js && node --check core/store.js && node --check core/usage.js && node --check core/projects.js && node --check core/connection.js && node --check core/approvals.js && node --check core/backups.js && node --check core/errors.js && node --check core/wordpress.js && node --check core/safety-tools.js && node --check core/updater.js && node --check core/brain.js && node --check renderer/app.js && node --check renderer/v07-runtime.js && node --check renderer/v08-runtime.js && node --check renderer/v081-runtime.js && node --check mcp-server.mjs",
    "test:mcp": "node scripts/smoke-mcp.mjs",
    "test:brain": "node scripts/smoke-brain.cjs",
    "test:wordpress": "node scripts/smoke-wordpress.cjs",
    "test:fastpath": "node scripts/smoke-fastpath.cjs",
    "test:regression": "node scripts/smoke-regression.cjs",
    "test:tunnel": "node scripts/smoke-tunnel.mjs",
    "test:safety": "node scripts/smoke-safety.cjs",
    "predist:win": "npm run prepare:icons",
    "dist:win": "electron-builder --win nsis --publish never",
    "predist:portable": "npm run prepare:icons",
    "dist:portable": "electron-builder --win portable --publish never"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "cloudflared": "0.7.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "lucide": "1.34.0",
    "sharp": "0.34.3"
  },
  "build": {
    "appId": "com.personal.chatcode",
    "productName": "ChatCode Cá Nhân",
    "asar": true,
    "files": [
      "main.js",
      "mcp-server.mjs",
      "preload.js",
      "core/**/*",
      "renderer/**/*",
      "assets/icon.png",
      "assets/THIRD_PARTY_ICONS.txt",
      "package.json"
    ],
    "win": {
      "target": ["nsis"],
      "icon": "assets/icon.ico",
      "artifactName": "ChatCode-Ca-Nhan-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ChatCode Cá Nhân",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    }
  }
}