{
  "name": "personal-chatcode",
  "version": "0.2.0",
  "description": "Local project bridge for ChatGPT over MCP",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test:mcp": "node scripts/smoke-mcp.mjs",
    "test:tunnel": "node scripts/smoke-tunnel.mjs",
    "dist:win": "electron-builder --win nsis --publish never",
    "dist:portable": "electron-builder --win portable --publish never"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "cloudflared": "0.7.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "electron": "44.0.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.personal.chatcode",
    "productName": "Personal ChatCode",
    "asar": true,
    "files": ["main.js", "mcp-server.mjs", "preload.js", "renderer/**/*", "package.json"],
    "win": {"target": ["nsis"], "artifactName": "Personal-ChatCode-Setup-${version}.${ext}"},
    "nsis": {"oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true}
  }
}
