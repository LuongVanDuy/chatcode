{
  "name": "personal-chatcode",
  "version": "0.5.0",
  "description": "Cầu nối dự án cục bộ cho ChatGPT qua MCP",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test:syntax": "node --check main.js && node --check preload.js && node --check renderer/app.js && node --check mcp-server.mjs",
    "test:mcp": "node scripts/smoke-mcp.mjs",
    "test:tunnel": "node scripts/smoke-tunnel.mjs",
    "dist:win": "electron-builder --win nsis --publish never",
    "dist:portable": "electron-builder --win portable --publish never"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "cloudflared": "0.7.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "electron": "44.0.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.personal.chatcode",
    "productName": "ChatCode Cá Nhân",
    "asar": true,
    "files": ["main.js", "mcp-server.mjs", "preload.js", "renderer/**/*", "assets/**/*", "package.json"],
    "win": {
      "target": ["nsis"],
      "icon": "assets/icon.ico",
      "artifactName": "ChatCode-Ca-Nhan-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ChatCode Cá Nhân",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    }
  }
}
